# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=deepseek/deepseek-chat-v3-0324

# Redis (handled by docker-compose)
REDIS_URL=redis://redis:6379

# Buffer thresholds
CHUNK_THRESHOLD=15
TIME_THRESHOLD_SECONDS=45

# Omi Integration API
OMI_API_URL=https://api.omi.me
OMI_APP_ID=your-app-id-here
OMI_APP_API_KEY=sk_your-api-key-here

# Confidence thresholds (0.0 to 1.0) — higher = stricter filtering
NOTIFY_CONFIDENCE_THRESHOLD=0.85
TASK_CONFIDENCE_THRESHOLD=0.6
MEMORY_CONFIDENCE_THRESHOLD=0.6

# Anti-spam cooldowns (seconds)
NOTIFICATION_COOLDOWN_SECONDS=300
MEMORY_COOLDOWN_SECONDS=600

# Daily verse cron settings
DAILY_VERSE_ENABLED=true
DAILY_VERSE_HOUR=9
USER_TIMEZONE=America/New_York
DAILY_VERSE_CONVERSATIONS_LIMIT=5

# System prompt override (optional — leave unset to use soul/ files + prompts/system.md)
# SYSTEM_PROMPT=...
