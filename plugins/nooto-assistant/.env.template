# Required — get from https://openrouter.ai
OPENROUTER_API_KEY=

# LLM model (default: qwen/qwen3-30b-a3b)
# LLM_MODEL=qwen/qwen3-30b-a3b

# Redis (default: redis://redis:6379 — works with docker compose)
# REDIS_URL=redis://redis:6379

# Omi Integration (required for push notifications)
OMI_APP_ID=
OMI_APP_API_KEY=
# OMI_API_URL=https://api.omi.me

# Buffer thresholds
# CHUNK_THRESHOLD=15
# TIME_THRESHOLD_SECONDS=45

# Anti-spam cooldown (seconds) — shorter than grammarly since this is Q&A
# NOTIFICATION_COOLDOWN_SECONDS=30

# Hybrid delivery: seconds to wait for webhook before falling back to API
# WEBHOOK_FALLBACK_SECONDS=45

# Seconds to collect segments after trigger word before processing
# TRIGGER_COLLECT_SECONDS=10
