# Required — get from https://openrouter.ai
OPENROUTER_API_KEY=

# LLM model (default: deepseek/deepseek-chat-v3-0324)
# LLM_MODEL=deepseek/deepseek-chat-v3-0324

# Redis (default: redis://redis:6379 — works with docker compose)
# REDIS_URL=redis://redis:6379

# Omi Integration (optional — needed for memory creation)
OMI_APP_ID=
OMI_APP_API_KEY=
# OMI_API_URL=https://api.omi.me

# Buffer thresholds
# CHUNK_THRESHOLD=15
# TIME_THRESHOLD_SECONDS=45

# Confidence thresholds
# NOTIFY_CONFIDENCE_THRESHOLD=0.85
# MEMORY_CONFIDENCE_THRESHOLD=0.6

# Anti-spam cooldowns (seconds)
# NOTIFICATION_COOLDOWN_SECONDS=300
# MEMORY_COOLDOWN_SECONDS=600
